# Root .htaccess — forwards everything into /public (the Laravel front controller)
# Use this only if your hosting cannot point the document root to /public.
# Defensive: prefer index.php over the legacy static index.html
# (the rewrite below already forwards everything into /public, so this
# only matters if mod_rewrite is ever disabled.)
DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Single-hop canonical redirect (no chains: directly to https://khaledahmed.net)
    RewriteCond %{HTTP_HOST} !^khaledahmed\.net$ [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
    RewriteRule ^ https://khaledahmed.net%{REQUEST_URI} [R=301,L]

    # Forward into /public (Laravel front controller)
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
